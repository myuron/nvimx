# Build-time remote-plugin manifest (#85): what :UpdateRemotePlugins would write for the plugins
# in the farm, produced while nvimx builds so that nothing has to run after a switch or an update.
# See lua/nvimx/rplugin-gen.lua for what runs inside neovim, and lua/nvimx/rplugin-load.lua for how
# the result is loaded at run time.
#   package  the neovim that generates (not the final wrapper: the wrapper's rc depends on this
#            derivation, so using it here would be circular)
#   farm     the plugin farm; every entry is a candidate
#   hosts    host names to register for ("python3" / "ruby" / "node"); only these are staged, so
#            a host the user did not turn on is never searched for or started
#   hostRc   today's provider rc (the vim.g.*_host_prog lines), run with --cmd
#   path     what the hosts need on PATH while generating (node must be there)
#   exclude  farm entries to leave alone (dev plugins stay with :UpdateRemotePlugins)
{ pkgs }:
{
  package,
  farm,
  hosts,
  hostRc,
  path ? [ ],
  exclude ? [ ],
}:
let
  inherit (pkgs) lib;
in
pkgs.runCommand "nvimx-rplugin-manifest.vim" { } ''
  export HOME=$TMPDIR XDG_CONFIG_HOME=$TMPDIR/config XDG_DATA_HOME=$TMPDIR/data \
         XDG_STATE_HOME=$TMPDIR/state XDG_CACHE_HOME=$TMPDIR/cache
  ${lib.optionalString (path != [ ]) "export PATH=${lib.makeBinPath path}:$PATH"}

  # Which plugins have something to register is decided here, at build time: reading the farm at
  # evaluation time would be IFD. Each plugin is staged as a directory holding only the rplugin/
  # dirs of hosts that are on, symlinked from the farm. neovim resolves symlinks when it records a
  # path, so the manifest names the plugin's own store path, the same string a user's own
  # :UpdateRemotePlugins records.
  mkdir stage
  for dir in ${farm}/*; do
    name=$(basename "$dir")
    skip=
    for ex in lazy.nvim ${lib.escapeShellArgs exclude}; do
      if [ "$name" = "$ex" ]; then skip=1; fi
    done
    if [ -n "$skip" ]; then continue; fi
    for host in ${lib.escapeShellArgs hosts}; do
      if [ -d "$dir/rplugin/$host" ]; then
        mkdir -p "stage/$name/rplugin"
        ln -s "$dir/rplugin/$host" "stage/$name/rplugin/$host"
      fi
    done
  done

  echo '" Generated by nvimx at build time (#85) for: ${lib.concatStringsSep " " hosts}' > $out
  # Nothing staged: no neovim run at all, and the manifest is the header only.
  if [ -n "$(ls -A stage)" ]; then
    # Upstream's variable, read when runtime/plugin/rplugin.vim is sourced; the raw manifest
    # lands here and rplugin-gen.lua copies it to stdout after checking it.
    export NVIM_RPLUGIN_MANIFEST=$TMPDIR/raw.vim
    # -u NORC, not -u NONE: with NONE no plugin is loaded and :UpdateRemotePlugins is not defined.
    # timeout: a host that hangs would otherwise hang the build; a failing plugin is not fatal
    # (the plugin is left out and the error stays in the log), but a hang or a crash is.
    timeout 600 ${package}/bin/nvim -u NORC -i NONE -n --cmd "luafile ${hostRc}" \
      -l ${../../lua/nvimx/rplugin-gen.lua} "$PWD/stage" "$TMPDIR/raw.vim" >> $out
  fi
''
