# programs.nvimx: the home-manager module.
# It embeds lib.makeEnv and deploys the wrapped neovim + nvimx-lock from a single place.
# lazyNvimSeed is nvimx's flake input (partially applied in flake.nix).
{ lazyNvimSeed }:
{
  config,
  lib,
  pkgs,
  ...
}:
let
  cfg = config.programs.nvimx;
  nvimxLib = import ../lib { inherit pkgs lazyNvimSeed; };

  # When projectDir is set, wrap the command so that configDir/lockDir default to it. The
  # defaults are prepended unconditionally rather than only when "$@" is empty (#24): lock-app's
  # own parser lets the same flag win on its last occurrence (its case loop just keeps
  # overwriting config=/out= as it sees them), so an explicit --config/--out later in "$@" still
  # overrides these -- and --update's name-collecting loop stops at the first "--" it sees, so it
  # can never absorb a flag that was prepended ahead of it.
  lockCommand =
    if cfg.lock.projectDir == null then
      nvimxLib.lockApp
    else
      pkgs.writeShellScriptBin "nvimx-lock" ''
        project=${lib.escapeShellArg cfg.lock.projectDir}
        project=''${project/#\~/$HOME}
        exec ${nvimxLib.lockApp}/bin/nvimx-lock \
          --config "$project/"${lib.escapeShellArg cfg.lock.configDirRelative} \
          --out "$project/"${lib.escapeShellArg cfg.lock.lockDirRelative} \
          "$@"
      '';
in
{
  options.programs.nvimx = {
    enable = lib.mkEnableOption "nvimx (nix x neovim manager)";

    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.neovim-unwrapped;
      defaultText = lib.literalExpression "pkgs.neovim-unwrapped";
      description = ''
        neovim itself (an -unwrapped style derivation).
        A package from neovim-nightly-overlay works here too.
      '';
    };

    configDir = lib.mkOption {
      type = lib.types.nullOr lib.types.path;
      default = null;
      example = lib.literalExpression "./nvim";
      description = ''
        The lua config directory containing init.lua.
        When manageConfig = true it is deployed from the store via xdg.configFile.
      '';
    };

    lockDir = lib.mkOption {
      type = lib.types.path;
      example = lib.literalExpression "./nvim/nvimx-lock";
      description = ''
        Where the plugins.json / flake.nix / flake.lock generated by nvimx-lock live.
        If they have not been generated yet (no lock), the build degrades.
      '';
    };

    manageConfig = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        true: deploy configDir from the store via xdg.configFile (reproducibility-first, the default).
        false: ~/.config/nvim stays user-managed (for fast iteration).
      '';
    };

    vimAlias = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Add a symlink so that the `vim` command launches the wrapped neovim";
    };

    viAlias = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = "Add a symlink so that the `vi` command launches the wrapped neovim";
    };

    defaultEditor = lib.mkOption {
      type = lib.types.bool;
      default = false;
      description = ''
        Set EDITOR to `nvim` in home.sessionVariables.

        EDITOR only. home-manager's own programs.neovim.defaultEditor sets VISUAL as well;
        nvimx does not, so a VISUAL you set yourself stays yours.

        The value is the bare command name rather than a path into the Nix store. It resolves
        through PATH, which home.packages already covers, and hm-session-vars.sh exports it
        into the session, where a store path would outlive the generation that set it in every
        shell still running.

        Anything else that sets home.sessionVariables.EDITOR meets this the way home-manager
        merges any two definitions: the same value merges in silence, a different one fails the
        evaluation, and nvimx neither yields to it nor overrides it. programs.neovim, enabled
        and with its own defaultEditor on, is the silent case -- the same bare "nvim", plus a
        VISUAL of its own. programs.vim / programs.helix, likewise enabled with theirs on, are
        the failing one (any of those modules with defaultEditor off, or not enabled at all,
        contributes nothing here), and so is a hand-written EDITOR line whose value is anything
        but "nvim" -- delete that line rather than keep both, since replacing it is what this
        option is for. The error names home-manager's module file but never nvimx's, and between
        nvimx and a hand-written line inside a flake it names neither.

        All of this is home-manager's own layer. On NixOS the system also exports EDITOR=nano by
        default (environment.variables, mkDefault, in nixos/modules/programs/environment.nix,
        whatever programs.nano.enable says), and that never merges with home.sessionVariables:
        whichever startup file exports last wins. In a shell home-manager manages, NixOS's own
        init (/etc/profile, /etc/zshenv, nixos-env-preinit.fish) runs first and home-manager's
        session variables after it -- for bash only in a login shell, for zsh and fish in every
        shell -- so nvim wins there. When the session's first (login) shell is one home-manager
        does not manage, they are never sourced and nano is all that is left. Let home-manager
        manage that shell, or set environment.variables.EDITOR = lib.mkForce null in the NixOS
        configuration. The README's "defaultEditor on NixOS" has the details.
      '';
    };

    extraPackages = lib.mkOption {
      type = lib.types.listOf lib.types.package;
      default = [ ];
      example = lib.literalExpression "[ pkgs.ripgrep pkgs.lua-language-server ]";
      description = "Packages prepended to the wrapper's PATH (ripgrep, lsp servers, etc.)";
    };

    extraLuaPackages = lib.mkOption {
      type = lib.types.functionTo (lib.types.listOf lib.types.package);
      default = _: [ ];
      defaultText = lib.literalExpression "ps: [ ]";
      example = lib.literalExpression "ps: [ ps.inspect ]";
      description = ''
        Lua rocks to put on the wrapper's LUA_PATH / LUA_CPATH, as a function over a Lua
        package set -- the same shape as home-manager's programs.neovim.extraLuaPackages.

        The set handed to the function is the one belonging to the neovim in `package`
        (its passthru.lua.pkgs, i.e. luajitPackages for a stock nixpkgs neovim), so the
        rocks always match the interpreter that will load them. A package with no
        passthru.lua -- an already-wrapped pkgs.neovim, say -- is rejected rather than
        matched against some other interpreter's rocks.

        This is the supported way to satisfy a luarocks dependency: nvimx forces lazy.nvim's
        rocks.enabled = false, so a `build = "rockspec"` is never run. Naming the rock here
        does not make that build run either; it puts the dependency in place instead.

        Only LUA_PATH / LUA_CPATH are touched. Use extraPackages for anything that has to
        land on PATH -- no Lua interpreter from this option is added to it. They are
        exported, so anything neovim launches -- a :terminal shell, a language server, a
        :! command -- inherits them.
      '';
    };

    extraWrapperArgs = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      example = lib.literalExpression ''
        [
          "--set"
          "MY_ASSET_DIR"
          "''${pkgs.someAsset}/share"
          "--suffix"
          "PATH"
          ":"
          "''${lib.makeBinPath [ pkgs.nodejs ]}"
        ]
      '';
      description = ''
        Extra arguments for the makeWrapper call that builds the wrapped neovim, as a flat list
        with one makeWrapper argument per element -- the same shape as home-manager's
        programs.neovim.extraWrapperArgs. Every element is shell-escaped on its way there, so it
        may contain spaces, quotes, `;` or `$` and still reaches makeWrapper as the one argument
        you wrote.

        Use it for what extraPackages and extraLuaPackages do not cover: an environment variable
        set for neovim rather than for your whole session (a path to a Nix-built asset that Lua
        reads through vim.env), a PATH entry that should lose to the PATH you already have rather
        than win (--suffix, where extraPackages uses --prefix), an extra command-line flag.

        The arguments are appended after nvimx's own, and makeWrapper applies them in order:
        first --add-flags "--cmd 'luafile <bootstrap.lua>'", then --prefix PATH for
        extraPackages, then LUA_PATH / LUA_CPATH for extraLuaPackages, then what withPython3 /
        withRuby / withNodeJs ask for (a second --cmd and a --suffix PATH), then these. They
        therefore act on what nvimx set up: a --prefix PATH here lands in front of
        extraPackages, an --add-flags here follows nvimx's --cmd, and a --set replaces the
        variable outright. home-manager orders this differently: it applies extraPackages (as
        --suffix PATH) after your arguments, so a list ported from programs.neovim.extraWrapperArgs
        that touches PATH can behave differently here.

        nvimx protects none of its own arguments from them. `--set PATH` discards
        extraPackages, and with it the PATH entries withRuby / withNodeJs added -- the Node.js
        host no longer starts without its node. `--set LUA_PATH` discards the rocks' Lua
        modules, and the interpreter's own default search path too unless the new value
        contains `;;` (LUA_CPATH is a separate variable and stays). An --add-flags can change
        how neovim starts. That is deliberate --
        this is the escape hatch -- so what you write here is yours to keep working.

        Some makeWrapper arguments take shell text rather than a literal value: --add-flags,
        --append-flags, --run and --argv0 (in nixpkgs' makeWrapper) are spliced into the wrapper
        script as they are and interpreted by the shell each time neovim starts, so a `$VAR` in
        them is expanded then; --argv0 is expanded inside double quotes, so without word
        splitting. Use --add-flag / --append-flag for a single literal argument; they need
        nixpkgs 25.05 or later (the one your home-manager configuration uses), or the build
        fails with "makeWrapper doesn't understand the arg --add-flag". A variable set here
        is exported, so the processes neovim starts -- a :! command, a :terminal shell, a
        language server -- inherit it unless they are started with an environment of their own.
      '';
    };

    withPython3 = lib.mkOption {
      type = lib.types.nullOr lib.types.bool;
      default = null;
      example = true;
      description = ''
        The Python 3 provider, for remote plugins written in Python (rplugin/python3) and for
        :python3 / py3eval().

        true builds a host from nixpkgs -- pkgs.python3 with pynvim, plus extraPython3Packages --
        and points vim.g.python3_host_prog at it. false sets vim.g.loaded_python3_provider = 0:
        the provider is off and neovim does not search for one. Both mean what they mean in
        home-manager's programs.neovim.withPython3.

        null (the default) is the state programs.neovim does not have: nvimx says nothing, and
        neovim looks for a python3 with pynvim on PATH the first time something needs it. That is
        what nvimx did before this option existed, so a setup relying on it keeps working -- but
        it depends on what happens to be on PATH, so set true or false to make it reproducible.
        programs.neovim's own default is false from stateVersion 26.05 on and true before; when
        porting a configuration, write the value you were getting.

        The setting is applied with --cmd, before your init.lua, so a vim.g.python3_host_prog
        you set there still wins. With false that does not bring the provider back by itself:
        init.lua has to unset vim.g.loaded_python3_provider as well.

        nvimx does not generate a remote-plugin manifest. Run :UpdateRemotePlugins yourself, and
        again after a plugin update: the manifest records the plugin's path, which is a Nix store
        path that changes with the lock.
      '';
    };

    extraPython3Packages = lib.mkOption {
      type = lib.types.functionTo (lib.types.listOf lib.types.package);
      default = _: [ ];
      defaultText = lib.literalExpression "ps: [ ]";
      example = lib.literalExpression "ps: [ ps.jupyter-client ]";
      description = ''
        Python packages to add to the Python 3 provider's host, as a function over a Python
        package set -- the same shape as home-manager's programs.neovim.extraPython3Packages.
        The set is pkgs.python3's (pkgs.python3.pkgs); pynvim is always included.

        Only used when withPython3 = true: there is no host to add them to otherwise, and nvimx
        warns at activation time if packages are named without it. They are importable by
        Python remote plugins and by :python3, not by a python you start from :terminal -- no
        interpreter is put on PATH. Use extraPackages for that.

        The list is still evaluated when withPython3 is not true -- that is how the warning is
        produced -- so a package that fails to evaluate is an error either way.
      '';
    };

    withRuby = lib.mkOption {
      type = lib.types.nullOr lib.types.bool;
      default = null;
      example = true;
      description = ''
        The Ruby provider, for remote plugins written in Ruby and for :ruby / rubyeval().

        true points vim.g.ruby_host_prog at the neovim-ruby-host nixpkgs builds for its own
        neovim wrapper, false sets vim.g.loaded_ruby_provider = 0, and null (the default) leaves
        neovim's own discovery alone -- the same three states as withPython3, with the same
        relation to home-manager's programs.neovim.withRuby (false from stateVersion 26.05 on,
        true before).

        With true, that Ruby environment's bin/ is appended to the wrapper's PATH (--suffix, so
        a ruby you already have stays in front), which is what :checkhealth looks for. Unlike
        nixpkgs' wrapper, nvimx does not set GEM_HOME: the host runs without it, and it would be
        exported to every process neovim starts. Add it with extraWrapperArgs if you need it.
      '';
    };

    withNodeJs = lib.mkOption {
      type = lib.types.nullOr lib.types.bool;
      default = null;
      example = true;
      description = ''
        The Node.js provider, for remote plugins written in JavaScript (rplugin/node).

        true points vim.g.node_host_prog at pkgs.neovim-node-client's neovim-node-host, false
        sets vim.g.loaded_node_provider = 0, and null (the default) leaves neovim's own discovery
        alone -- the same three states as withPython3. programs.neovim.withNodeJs defaults to
        false.

        With true, pkgs.nodejs's bin/ is appended to the wrapper's PATH (--suffix, so a node you
        already have stays in front): neovim starts the host as `node <host>`, so it has to be
        there. As with programs.neovim, appending it also makes `node` available to plugins
        that run it themselves. The host therefore runs under the first node on PATH -- yours,
        if you have one; put pkgs.nodejs in extraPackages to pin it.
      '';
    };

    devPlugins = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      example = [ "my-plugin.nvim" ];
      description = ''
        Plugin names to load from a working tree under devPath instead of the Nix store. Use
        the name lazy derived for the plugin (the key in nvimx-lock/plugins.json).

        These plugins stay in the lock and in the farm, so removing a name here restores the
        pinned build with no re-lock. While a name is listed, that plugin is deliberately
        outside nvimx's reproducibility guarantee: the lock no longer describes what you run.

        Plugins your lazy spec itself marks `dev = true` are handled automatically and need
        no entry here; they follow devPath just the same -- unless that same spec entry also
        sets `dir`, in which case lazy uses the `dir` you wrote and devPath does not apply. A
        plugin whose spec sets `dir` without `dev` at all is handled automatically too, and
        falls into that same exception from the start: it needs no entry here, but devPath
        never applies to it either.
      '';
    };

    devPatterns = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      example = [ "ryoppippi" ];
      description = ''
        Substrings of a plugin's source url: every plugin whose url contains one of them loads
        from <devPath>/<name> instead of the Nix store. This is lazy.nvim's own `dev.patterns`:
        a plain, case-sensitive substring match against the url lazy derived (for example
        `https://github.com/<owner>/<repo>.git`), first match wins.

        Matching plugins stay in the lock and in the farm, so removing a pattern restores the
        pinned build with no re-lock. While a pattern matches, those plugins are deliberately
        outside nvimx's reproducibility guarantee.

        A spec entry with `dev = false` opts out, and one that sets `dir` keeps that `dir`.
        lazy.nvim itself is never moved. As with devPlugins, a missing working tree is not a
        fallback: the plugin simply shows as not installed.

        This replaces lazy.nvim's own `dev.patterns`; nvimx-lock warns if your spec sets it.
      '';
    };

    devPath = lib.mkOption {
      type = lib.types.str;
      default = "~/projects";
      example = "~/src";
      description = ''
        Where dev working trees live. A plugin nvimx develops locally -- named in devPlugins,
        matched by devPatterns, or marked `dev = true` by your own lazy spec, with no `dir` of its own -- resolves to
        <devPath>/<name>. A leading `~` is expanded by lazy.nvim at runtime, not here.

        The one exception is a spec entry that sets `dir` itself: lazy uses that path directly
        and never consults devPath for it. Short of that, devPath is the only thing deciding
        where a dev plugin is loaded from.

        This replaces lazy.nvim's own `dev.path`, which nvimx overrides the same way it
        overrides the rest of dev: set this rather than `dev.path` in your spec.

        A str rather than a path on purpose: a path would copy the working tree into the
        Nix store, which is an immutable snapshot -- exactly what this option exists to avoid.
      '';
    };

    plugins = {
      overrides = lib.mkOption {
        type = lib.types.attrsOf (lib.types.functionTo lib.types.package);
        default = { };
        example = lib.literalExpression ''
          {
            "markdown-preview.nvim" =
              { pkgs, defaultDrv, ... }:
              defaultDrv.overrideAttrs (o: {
                nativeBuildInputs = o.nativeBuildInputs ++ [ pkgs.nodejs ];
              });
          }
        '';
        description = ''
          Per-plugin derivation overrides, keyed by the plugin name lazy derived.
          The function receives { pkgs, name, src, build, defaultDrv, mkPluginDrv } and must
          return a derivation. Always accept `...` as well: more arguments may be added later.

          `src` is the locked source tree and `defaultDrv` is the derivation nvimx would
          have used without this override, so both patching (defaultDrv.overrideAttrs)
          and replacing it outright (build your own from src) work. `mkPluginDrv` is nvimx's
          generic builder ({ name, src, build } -> drv), for "the usual treatment, but with
          the build command corrected" -- which is also how to bypass a nix/build-registry
          recipe nvimx ships for the plugin.

          This wins over every other resolution step, and it is the way out when a plugin's
          build cannot run inside the nix sandbox.
        '';
      };

      nixpkgsFallback = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        example = [ "telescope-fzf-native.nvim" ];
        description = ''
          Plugin names to take from pkgs.vimPlugins as-is instead of building from the lock.
          Opt-in per plugin: matching names automatically would silently detach plugins from
          their flake.lock pins.

          The nixpkgs attribute is looked up by the name verbatim (LazyVim), then with "."
          replaced by "-" (CopilotChat.nvim -> CopilotChat-nvim), then lowercased on top of
          that (telescope.nvim -> telescope-nvim). A name that resolves to none of the three
          fails evaluation; use plugins.overrides to point at an attribute directly.
        '';
      };
    };

    treesitter = {
      grammars = lib.mkOption {
        type = lib.types.nullOr (
          lib.types.either (lib.types.enum [ "all" ]) (lib.types.listOf lib.types.str)
        );
        default = null;
        example = [
          "lua"
          "nix"
        ];
        description = ''
          Tree-sitter grammars to merge into the locked nvim-treesitter, so that the parsers
          are present at build time and `:TSInstall` never has to run.

          A list of nvim-treesitter language names ("c_sharp", not "c-sharp"), or "all" for
          every grammar nixpkgs ships (a large build -- name what you use instead).
          null (the default) leaves nvim-treesitter alone, parsers and all.

          Grammars come from pkgs.vimPlugins.nvim-treesitter.grammarPlugins, so their revs
          follow nixpkgs rather than the nvim-treesitter rev in your lock. Queries always come
          from your locked plugin. Has no effect unless nvim-treesitter is in the lock.
        '';
      };
    };

    check = {
      ignoreErrors = lib.mkOption {
        type = lib.types.listOf lib.types.str;
        default = [ ];
        example = [ "copilot" ];
        description = ''
          Errors that env.check tolerates: any error whose whole message contains one of
          these strings is dropped. Plain substrings, not Lua patterns, matched against the
          message as it shows in the build log (which can carry a prefix such as
          `Error in <file>:`).

          For plugins that need the network at startup, prefer fixing the cause
          (treesitter.grammars instead of :TSInstall) or switching the plugin off for the
          check: NVIMX_CHECK=1 is set in neovim's environment, so
          `cond = not vim.env.NVIMX_CHECK` works.
        '';
      };
    };

    lock = {
      installCommand = lib.mkOption {
        type = lib.types.bool;
        default = true;
        description = "Add the nvimx-lock command to home.packages";
      };

      projectDir = lib.mkOption {
        type = lib.types.nullOr lib.types.str;
        default = null;
        example = "~/dotfiles";
        description = ''
          The working tree of your dotfiles repository. When set, `nvimx-lock` --
          with or without extra arguments, e.g. `nvimx-lock --update <name>` -- targets
          configDirRelative / lockDirRelative by default; an explicit --config / --out still wins.
        '';
      };

      configDirRelative = lib.mkOption {
        type = lib.types.str;
        default = "nvim";
        description = "Path to configDir, relative to projectDir";
      };

      lockDirRelative = lib.mkOption {
        type = lib.types.str;
        default = "nvim/nvimx-lock";
        description = "Path to lockDir, relative to projectDir";
      };
    };

    env = lib.mkOption {
      type = lib.types.attrs;
      defaultText = lib.literalExpression "nvimx lib.makeEnv { ... }";
      description = ''
        The result of makeEnv (farm / bootstrap / wrapped / pluginDrvs /
        unknownPluginNames / treesitterWithoutPlugin / devDirs / devPatterns /
        unknownDevPluginNames / unusedPython3Packages / hasLock), plus `check`: a derivation that starts the wrapped
        neovim headless and offline with configDir, loads every plugin in the farm and fails on
        any startup error. Wire it into your flake with
        `checks.''${system}.nvim = <hm config>.config.programs.nvimx.env.check;`. It needs
        configDir (accessing it without one is an evaluation error). `dev` plugins are
        skipped. See `check.ignoreErrors`.
        By default it is built automatically from the options above.
        This is an escape hatch for advanced users who want to supply it directly.
        Setting it replaces the makeEnv call, so every option that only feeds makeEnv is
        silently ignored: package, lockDir, extraPackages, extraLuaPackages, extraWrapperArgs,
        withPython3, withRuby, withNodeJs, extraPython3Packages, vimAlias, viAlias, plugins.*,
        treesitter.*, devPlugins and devPath.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = cfg.manageConfig -> cfg.configDir != null;
        message = "programs.nvimx: manageConfig = true requires configDir to be set";
      }
    ];

    warnings =
      lib.optional (!(cfg.env.hasLock or true)) ''
        programs.nvimx: lock files (plugins.json / flake.lock) not found in lockDir.
        Building in degraded mode (lazy.nvim seed only).
        Run `nvimx-lock`, commit the lock files, then re-run home-manager switch.
        If you already did, your flake cannot see them: a flake only sees files git tracks
        (`git add` them, with -f if lockDir is gitignored), and a lockDir inside a git
        submodule also needs `inputs.self.submodules = true;` in your flake.
      ''
      ++ lib.optional ((cfg.env.unknownPluginNames or [ ]) != [ ]) ''
        programs.nvimx: plugins.overrides / plugins.nixpkgsFallback name plugins that are
        not in the lock, so they have no effect:
        ${lib.concatMapStringsSep "\n" (n: "  - ${n}") (cfg.env.unknownPluginNames or [ ])}
        Use the name lazy derived for the plugin (the key in nvimx-lock/plugins.json).
      ''
      ++ lib.optional (cfg.env.treesitterWithoutPlugin or false) ''
        programs.nvimx: treesitter.grammars is set, but nvim-treesitter is not in the lock,
        so the grammars have nowhere to go and are ignored.
        Add nvim-treesitter to your lazy spec and re-run `nvimx-lock`, or set
        treesitter.grammars = null.
      ''
      ++ lib.optional ((cfg.env.unknownDevPluginNames or [ ]) != [ ]) ''
        programs.nvimx: devPlugins names plugins that are in neither the lock nor its
        localPlugins, so nvimx cannot confirm the name:
        ${lib.concatMapStringsSep "\n" (n: "  - ${n}") (cfg.env.unknownDevPluginNames or [ ])}
        Use the name lazy derived for the plugin (the key in nvimx-lock/plugins.json); if you
        added the plugin to your spec without re-locking, re-run `nvimx-lock`.
      ''
      ++ lib.optional (cfg.env.unusedPython3Packages or false) ''
        programs.nvimx: extraPython3Packages names packages, but withPython3 is not true, so
        there is no Python 3 host to add them to and they are ignored.
        Set withPython3 = true. (home-manager's programs.neovim turned it on by default before
        stateVersion 26.05; nvimx never does.)
      '';

    programs.nvimx.env = lib.mkDefault (
      nvimxLib.makeEnv {
        inherit (cfg)
          package
          lockDir
          extraPackages
          extraLuaPackages
          extraWrapperArgs
          withPython3
          withRuby
          withNodeJs
          extraPython3Packages
          vimAlias
          viAlias
          plugins
          treesitter
          devPlugins
          devPath
          devPatterns
          configDir
          check
          ;
      }
    );

    home.packages = [ cfg.env.wrapped ] ++ lib.optional cfg.lock.installCommand lockCommand;
    home.sessionVariables = lib.mkIf cfg.defaultEditor { EDITOR = "nvim"; };

    xdg.configFile = lib.mkIf cfg.manageConfig {
      nvim.source = cfg.configDir;
    };

    # Make the fs_stat in the standard bootstrap snippet succeed, neutralizing its git clone
    xdg.dataFile."nvim/lazy/lazy.nvim".source = "${cfg.env.farm}/lazy.nvim";
  };
}
